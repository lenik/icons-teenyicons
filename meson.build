project('icons-teenyicons',
  version: '1.0.0',
  license: 'MIT',
  meson_version: '>= 0.61.0')

fs = import('fs')
prefix = get_option('prefix')
bindir = prefix / get_option('bindir')
datadir = prefix / get_option('datadir')
pkgdatadir = datadir / 'icons-teenyicons'
ilib_librarydir = datadir / 'iconlibutils' / 'library'

install_data('bin/icons-teenyicons', install_dir: bindir, install_mode: 'rwxr-xr-x')

# Source library.iconlib → /usr/share/iconlibutils/library/teenyicons
install_data(
  'library.iconlib',
  rename: 'teenyicons',
  install_dir: ilib_librarydir,
)

if fs.is_dir('orig/.')
  install_subdir('orig/.', install_dir: pkgdatadir, strip_directory: true)
elif fs.is_dir('orig') and '.' == '.'
  foreach sub : ['icons', 'svg', 'SVG', 'SVGs', 'src', 'assets', 'flags']
    if fs.is_dir('orig' / sub)
      install_subdir('orig' / sub, install_dir: pkgdatadir)
    endif
  endforeach
endif

# --- preview / FAISS (generated by: iconlib index -F) ---
# Web preview → index/ (gitignored); FAISS → faiss.* at package root (tracked).
if fs.is_dir('index')
  install_subdir('index', install_dir: pkgdatadir)
endif
foreach _faiss : ['faiss.index', 'faiss.map', 'faiss.json']
  if fs.is_file(_faiss)
    install_data(_faiss, install_dir: pkgdatadir)
  endif
endforeach
